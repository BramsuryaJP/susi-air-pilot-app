    "postinstall": "nuxt prepare",
    "test": "node --test test/unit/*.test.mjs"
  },
  "dependencies": {
    "@pinia/nuxt": "0.11.3",
    "nuxt": "^3.21.11",
    "ofetch": "^1.5.1",
    "pinia": "^3.0.4",
    "vue": "^3.5.40",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.13.0",
    "sass": "^1.105.2",
    "typescript": "~5.9.3",
    "vue-tsc": "^3.3.13"
  },
  "packageManager": "npm@11.21.1",
  "engines": {
    "node": "^22.22.3",
    "npm": "^11.21.1"
  }
}
